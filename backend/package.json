{
  "name": "ventus-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Recovered AWS Lambda backend source for Ventus API pilot-readiness work.",
  "scripts": {
    "list:functions": "node ./scripts/list-functions.mjs",
    "package:functions": "node ./scripts/package-functions.mjs",
    "package:monitors": "node ./scripts/package-monitors.mjs",
    "smoke:api": "node ./scripts/smoke-api.mjs",
    "plaid:sandbox:pull": "node ./eval/pull-plaid-sandbox-transactions.mjs",
    "plaid:benchmark:manifest": "node ./eval/generate-plaid-benchmark-manifest.mjs",
    "plaid:benchmark:synthetic": "node ./eval/generate-plaid-synthetic-benchmark.mjs",
    "plaid:benchmark:openrouter": "node ./eval/capture-openrouter-benchmark-predictions.mjs",
    "plaid:benchmark:openrouter:suite": "node ./eval/run-openrouter-benchmark-suite.mjs",
    "plaid:benchmark:rebuild": "node ./eval/rebuild-openrouter-benchmark-predictions.mjs",
    "plaid:benchmark:evaluate": "node ./eval/evaluate-plaid-benchmark-run.mjs",
    "plaid:benchmark:compare": "node ./eval/compare-plaid-benchmark-runs.mjs",
    "plaid:benchmark:audit-failures": "node ./eval/audit-plaid-benchmark-failures.mjs",
    "model-eval:run": "node ./eval/model-eval/run-task-eval.mjs",
    "model-eval:fidelity": "node ./eval/model-eval/run-task-eval.mjs --task merchant_classification_fidelity",
    "model-eval:test": "node --test ./eval/model-eval/scoring.test.mjs ./eval/model-eval/leaderboard.test.mjs ./eval/model-eval/tasks.test.mjs ./eval/model-eval/classify-fidelity.test.mjs",
    "plaid:diversity:manifest": "node ./eval/generate-plaid-diversity-manifest.mjs",
    "plaid:pfc:analyze": "node ./eval/analyze-plaid-pfc-coverage.mjs",
    "plaid:golden:candidates": "node ./eval/generate-plaid-golden-candidates.mjs",
    "plaid:golden:fixture": "node ./eval/build-plaid-golden-enrich-fixture.mjs",
    "plaid:enrichment:capture": "node ./eval/capture-plaid-enrichment-predictions.mjs",
    "qa:enrichment": "node ./scripts/qa-enrichment-contract.mjs",
    "qa:partner-ingest": "node ./scripts/qa-partner-ingest.mjs",
    "qa:golden": "node ./eval/qa-golden-enrichment.mjs",
    "qa:model-output": "node ./eval/qa-model-output-report.mjs",
    "qa:interventions": "node ./eval/qa-intervention-planner.mjs",
    "review:interventions:prepare": "node ./eval/prepare-intervention-review.mjs",
    "review:interventions:adjudicate": "node ./eval/adjudicate-intervention-review.mjs",
    "qa:mvp-cohorts": "node --experimental-strip-types ./scripts/qa-growth-play-cohorts.mjs",
    "qa:growth-plays": "node ./scripts/compile-growth-play-contracts.mjs",
    "qa:outcomes": "node ./scripts/qa-outcome-feed-contract.mjs && node ./scripts/qa-connected-exposure-contract.mjs",
    "plaid:mvp:manifests": "node --experimental-strip-types ./eval/generate-plaid-mvp-manifests.mjs",
    "benchmark:mvp": "VENTUS_SCALE_HOUSEHOLDS=50000 node --experimental-strip-types ./scripts/benchmark-growth-play-pipeline.mjs",
    "qa:live": "node ./scripts/qa-live-pipeline.mjs",
    "load:enrich": "node ./scripts/load-test-enrich.mjs",
    "docs:api": "node ./scripts/generate-api-docs.mjs && node ./scripts/generate-postman-collection.mjs",
    "validate:openapi": "node ./scripts/validate-openapi.mjs",
    "check:openapi-contract": "node ./scripts/check-openapi-contract.mjs",
    "check:routes": "node ./scripts/check-route-coverage.mjs",
    "check:cors": "node ./scripts/check-api-cors-readiness.mjs",
    "check:imports": "node ./scripts/check-relative-imports.mjs",
    "check:model-gateway": "node ./scripts/check-model-gateway-readiness.mjs",
    "check:model-gateway-deploy": "node ./scripts/check-model-gateway-deploy-readiness.mjs",
    "check:pipeline-readiness": "node ./scripts/check-pipeline-readiness.mjs",
    "check:persistence": "node ./scripts/check-persistence-readiness.mjs",
    "coworker:test": "node --test \"./shared/coworker/*.test.mjs\"",
    "test": "node --test \"./shared/**/*.test.mjs\" \"./scripts/lib/*.test.mjs\" \"./eval/lib/*.test.mjs\" \"./monitors/**/*.test.mjs\""
  }
}
