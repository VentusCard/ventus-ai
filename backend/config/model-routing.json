{
  "version": 1,
  "default_provider": "gemini",
  "default_model": "gemini-2.5-flash",
  "providers": {
    "gemini": {
      "type": "openai_compatible",
      "endpoint": "https://generativelanguage.googleapis.com/v1beta/openai/chat/completions",
      "api_key_secret_field": "GEMINI_API_KEY"
    },
    "openrouter": {
      "type": "openai_compatible",
      "endpoint": "https://openrouter.ai/api/v1/chat/completions",
      "api_key_secret_field": "OPENROUTER_API_KEY"
    }
  },
  "tasks": {
    "merchant_classification": {
      "provider": "gemini",
      "model": "gemini-2.5-flash",
      "role": "fast_worker",
      "temperature": 0,
      "max_tokens": 4000
    },
    "life_event_detection": {
      "provider": "gemini",
      "model": "gemini-2.5-flash",
      "role": "reasoning_worker",
      "temperature": 0,
      "max_tokens": 8000
    },
    "life_event_detection_shadow": {
      "provider": "gemini",
      "model": "gemini-2.5-flash",
      "role": "reasoning_worker_shadow",
      "temperature": 0,
      "max_tokens": 8000,
      "shadow_only": true,
      "compares_to": "life_event_detection"
    },
    "risk_detection": {
      "provider": "gemini",
      "model": "gemini-2.5-flash",
      "role": "risk_worker",
      "temperature": 0,
      "max_tokens": 2000
    },
    "travel_detection": {
      "provider": "gemini",
      "model": "gemini-2.5-flash",
      "role": "domain_worker",
      "temperature": 0,
      "max_tokens": 2000
    },
    "enrichment_judge": {
      "provider": "gemini",
      "model": "gemini-2.5-flash",
      "role": "qa_judge",
      "temperature": 0,
      "max_tokens": 4000,
      "shadow_only": true
    },
    "benchmark_enrichment": {
      "provider": "openrouter",
      "model": "z-ai/glm-5.2",
      "role": "benchmark_worker",
      "temperature": 0,
      "max_tokens": 8000,
      "shadow_only": true
    },
    "eval_enterprise_signal_extraction": {
      "provider": "openrouter",
      "model": "openai/gpt-4.1-mini",
      "role": "enterprise_fast_structured_worker",
      "temperature": 0,
      "max_tokens": 2500,
      "shadow_only": true
    },
    "eval_enterprise_opportunity_reasoning": {
      "provider": "openrouter",
      "model": "z-ai/glm-5.2",
      "role": "enterprise_deep_reasoning_worker",
      "temperature": 0,
      "max_tokens": 5000,
      "shadow_only": true
    },
    "eval_enterprise_opportunity_qa": {
      "provider": "openrouter",
      "model": "openai/gpt-4.1-mini",
      "role": "enterprise_consistency_judge",
      "temperature": 0,
      "max_tokens": 2500,
      "shadow_only": true
    },
    "coworker_intent_classification": {
      "provider": "gemini",
      "model": "gemini-2.5-flash",
      "role": "coworker_fast_router",
      "temperature": 0,
      "max_tokens": 1000
    },
    "coworker_reply": {
      "provider": "gemini",
      "model": "gemini-2.5-flash",
      "role": "coworker_reasoning_worker",
      "temperature": 0.3,
      "max_tokens": 4000
    },
    "coworker_audience_build": {
      "provider": "gemini",
      "model": "gemini-2.5-flash",
      "role": "coworker_reasoning_worker",
      "temperature": 0.2,
      "max_tokens": 6000
    },
    "coworker_prep": {
      "provider": "gemini",
      "model": "gemini-2.5-flash",
      "role": "coworker_reasoning_worker",
      "temperature": 0.3,
      "max_tokens": 5000
    },
    "coworker_summary": {
      "provider": "gemini",
      "model": "gemini-2.5-flash",
      "role": "coworker_reasoning_worker",
      "temperature": 0.2,
      "max_tokens": 3000
    }
  }
}
