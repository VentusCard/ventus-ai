{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ventusai.com/contracts/outcome-feed/v1.json",
  "title": "Ventus pilot outcome event",
  "description": "Provider-neutral contract for measuring employee actions and incremental customer outcomes. Direct customer PII is prohibited.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "event_id",
    "tenant_id",
    "household_token",
    "growth_play_id",
    "decision_id",
    "event_type",
    "occurred_at",
    "assignment",
    "source_system"
  ],
  "properties": {
    "contract_version": { "const": "1.0" },
    "event_id": { "type": "string", "minLength": 8, "maxLength": 128 },
    "tenant_id": { "type": "string", "minLength": 2, "maxLength": 64 },
    "household_token": { "type": "string", "pattern": "^tok_[A-Za-z0-9_-]{8,120}$" },
    "growth_play_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$" },
    "decision_id": { "type": "string", "minLength": 8, "maxLength": 128 },
    "activation_id": { "type": ["string", "null"], "maxLength": 128 },
    "event_type": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experiment_id", "arm", "assigned_at", "decision_protocol_id"],
      "properties": {
        "experiment_id": { "type": "string", "minLength": 3, "maxLength": 128 },
        "arm": { "enum": ["treatment", "holdout", "standalone", "connected"] },
        "assigned_at": { "type": "string", "format": "date-time" },
        "design": { "enum": ["binary", "connected_incrementality"] },
        "authorization_scope_id": { "type": "string", "minLength": 2, "maxLength": 128 },
        "decision_protocol_id": { "type": "string", "minLength": 2, "maxLength": 128 }
      },
      "allOf": [
        {
          "if": { "properties": { "arm": { "enum": ["standalone", "connected"] } } },
          "then": {
            "required": ["design", "authorization_scope_id", "decision_protocol_id"],
            "properties": { "design": { "const": "connected_incrementality" } }
          }
        },
        {
          "if": {
            "required": ["design"],
            "properties": { "design": { "const": "connected_incrementality" } }
          },
          "then": {
            "required": ["authorization_scope_id", "decision_protocol_id"],
            "properties": { "arm": { "enum": ["holdout", "standalone", "connected"] } }
          }
        },
        {
          "if": {
            "required": ["design"],
            "properties": { "design": { "const": "binary" } }
          },
          "then": { "properties": { "arm": { "enum": ["treatment", "holdout"] } } }
        }
      ]
    },
    "value": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["metric", "amount", "currency"],
      "properties": {
        "metric": { "enum": ["deposit_balance", "deposit_retained", "net_new_assets", "estimated_revenue"] },
        "amount": { "type": "number" },
        "currency": { "const": "USD" }
      }
    },
    "source_system": { "type": "string", "minLength": 2, "maxLength": 80 },
    "source_record_id": { "type": ["string", "null"], "maxLength": 128 },
    "reason_code": { "type": ["string", "null"], "maxLength": 128 }
  }
}
