{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ventusai.com/contracts/connected-exposure/v1.json",
  "title": "Ventus connected-data experiment exposure",
  "description": "Immutable receipt describing the data scope evaluated and whether an action was delivered. Direct customer PII is prohibited.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "event_id",
    "tenant_id",
    "experiment_id",
    "household_token",
    "arm",
    "decision_evaluated",
    "action_delivered",
    "connected_data_used",
    "authorization_scope_id",
    "decision_protocol_id",
    "occurred_at"
  ],
  "properties": {
    "contract_version": { "const": "1.0" },
    "event_id": { "type": "string", "minLength": 8, "maxLength": 128 },
    "tenant_id": { "type": "string", "minLength": 2, "maxLength": 64 },
    "experiment_id": { "type": "string", "minLength": 3, "maxLength": 128 },
    "household_token": { "type": "string", "pattern": "^tok_[A-Za-z0-9_-]{8,120}$" },
    "arm": { "enum": ["holdout", "standalone", "connected"] },
    "decision_evaluated": { "type": "boolean" },
    "action_delivered": { "type": "boolean" },
    "connected_data_used": { "type": "boolean" },
    "authorization_scope_id": { "type": "string", "minLength": 2, "maxLength": 128 },
    "decision_protocol_id": { "type": "string", "minLength": 2, "maxLength": 128 },
    "occurred_at": { "type": "string", "format": "date-time" }
  }
}
