{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npx tsx scripts/generate-sitemap.ts",
    "dev": "vite",
    "dev:connected": "ENABLE_LIVE_CONNECTORS=true VENTUS_ENABLE_DEMO_CONNECTOR_SESSION=true VENTUS_ALLOW_LOCAL_CONNECTORS=true vite",
    "prebuild": "npx tsx scripts/generate-sitemap.ts",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "test:capabilities": "node --experimental-strip-types scripts/verify-capability-gates.mjs",
    "test:pipeline": "node --experimental-strip-types scripts/verify-pipeline-real.mjs",
    "test:salesforce": "node --import tsx scripts/verify-salesforce.mjs",
    "test:decision-package": "node --import tsx --test src/lib/decisionPackage.test.ts",
    "test:connector-sessions": "node --import tsx --test api/_cognitoIdentity.test.ts api/_consoleAuth.test.ts api/console-access.test.ts api/_connectorAuth.test.ts api/_controlPlaneAuth.test.ts api/presenter-session.test.ts api/_decisionRuntime.test.ts api/decision-run.test.ts api/plaid-transactions.test.ts api/_plaidGovernedReview.test.ts api/salesforce-onboarding.test.ts api/salesforce-deliver.test.ts api/salesforce-outcomes.test.ts api/standalone-pilot-run.test.ts api/pilot-outcomes.test.ts",
    "test:leadership": "node --experimental-strip-types --test src/lib/leadership.test.ts src/lib/economics.test.ts backend/shared/pilot/salesforce-activation.test.mjs",
    "test:mvp-cohorts": "node --experimental-strip-types backend/scripts/qa-growth-play-cohorts.mjs",
    "test:growth-plays": "node backend/scripts/compile-growth-play-contracts.mjs",
    "test:outcomes": "node backend/scripts/qa-outcome-feed-contract.mjs && node backend/scripts/qa-connected-exposure-contract.mjs",
    "test:interventions": "node backend/eval/qa-intervention-planner.mjs",
    "interventions:review:prepare": "node backend/eval/prepare-intervention-review.mjs",
    "interventions:review:adjudicate": "node backend/eval/adjudicate-intervention-review.mjs",
    "test:plaid-source": "node backend/scripts/verify-plaid-source.mjs",
    "db:migrate": "node backend/scripts/apply-evidence-migrations.mjs",
    "db:verify": "node backend/scripts/verify-persistence-live.mjs",
    "pilot:e2e": "node --env-file-if-exists=.env.local --import tsx backend/scripts/pilot-e2e.mjs",
    "plaid:mvp:manifests": "node --experimental-strip-types backend/eval/generate-plaid-mvp-manifests.mjs",
    "benchmark:mvp": "VENTUS_SCALE_HOUSEHOLDS=50000 node --experimental-strip-types backend/scripts/benchmark-growth-play-pipeline.mjs",
    "preview": "vite preview"
  },
