# ─── Frontend (Vite, VITE_ prefix — bundled into the client) ────────────────
# Supabase project used by existing app features.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Google Maps browser key + channel used by the demo's local-partners map.
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=

# ─── Demo connectors (server-side) ──────────────────────────────────────────
# Hosted AWS credentials live in Secrets Manager, not here.
ENABLE_LIVE_CONNECTORS=true
VENTUS_ENABLE_DEMO_CONNECTOR_SESSION=true
VENTUS_DEMO_TENANT_ID=demo_bank
VENTUS_CONNECTOR_SESSION_SECRET=

# ─── Plaid (sandbox, server-side only) ──────────────────────────────────────
PLAID_ENV=sandbox
PLAID_BASE_URL=https://sandbox.plaid.com
PLAID_CLIENT_ID=
PLAID_SECRET=

# ─── Salesforce sandbox / Developer Edition (server-side only) ──────────────
SF_LOGIN_URL=https://your-domain.my.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# Optional standard Salesforce relationship link for sandbox Tasks.
SF_DEMO_ACCOUNT_ID=
# Optional FSC-native delivery: creates a Lead using the bank's Referral
# record type, then the linked Task. Task-only remains the fallback.
SF_REFERRAL_RECORD_TYPE_ID=

# ─── Model providers (server-side; local backend runs / evals) ──────────────
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ─── Local backend database (optional; used by scripts / load tests) ────────
DATABASE_URL=

# ─── Planned / not active yet ───────────────────────────────────────────────
# Auth-provider cutover. Keep Supabase active until the Cognito dual-run
# acceptance gates pass. While VENTUS_AUTH_PROVIDER=supabase, the Cognito
# values stay blank and are not read by the app.
VITE_AUTH_PROVIDER=supabase
VENTUS_AUTH_PROVIDER=supabase
VITE_COGNITO_AUTHORITY=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_ISSUER=

# ─── Supabase edge-function secrets (set in the Supabase dashboard, NOT here) ─
# Configure via `supabase secrets set`; listed for reference only:
#   RESEND_API_KEY   # transactional email (Resend)
#   LOVABLE_API_KEY  # Lovable AI gateway used by some edge functions
