# Supabase project used by existing app features.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Protected hosted Demo connector route. In Amplify, set this to the
# DemoConnectorApiBaseUrl CDK output.
VITE_DEMO_CONNECTOR_API_BASE_URL=

# Protected Demo connector settings. Hosted AWS credentials live in Secrets Manager.
ENABLE_LIVE_CONNECTORS=true
VENTUS_ENABLE_DEMO_CONNECTOR_SESSION=true
VENTUS_DEMO_TENANT_ID=demo_bank
VENTUS_CONNECTOR_SESSION_SECRET=
# Frontend and server switches must move together. Keep Supabase active until
# the Cognito dual-run acceptance gates pass.
VITE_AUTH_PROVIDER=supabase
VENTUS_AUTH_PROVIDER=supabase

# AWS identity foundation. These are identifiers and public endpoints, not secrets.
# The frontend variables remain blank while VENTUS_AUTH_PROVIDER=supabase.
VITE_COGNITO_AUTHORITY=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_ISSUER=

# Plaid sandbox (server-side only)
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=

# Salesforce sandbox / Developer Edition (server-side only)
SF_LOGIN_URL=https://your-domain.my.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# Optional standard Salesforce relationship links for sandbox Tasks.
SF_DEMO_CONTACT_ID=
SF_DEMO_ACCOUNT_ID=
# Optional FSC-native delivery. When enabled, the connector creates a Lead using the
# bank's Referral record type, then creates the linked Task. Task-only remains the fallback.
SF_FSC_REFERRAL_ENABLED=false
SF_FSC_REFERRAL_RECORD_TYPE_ID=
# Optional FSC mirror of Ventus's canonical Decision Package. Requires the
# Ventus_Decision__c metadata in salesforce/force-app to be deployed first.
SF_VENTUS_DECISION_ENABLED=false
