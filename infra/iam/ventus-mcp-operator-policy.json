{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectVentusStacksViaAwsMcp",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeChangeSet",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResource",
        "cloudformation:DescribeStackResources",
        "cloudformation:DescribeStacks",
        "cloudformation:GetTemplate",
        "cloudformation:GetTemplateSummary",
        "cloudformation:ListStackResources"
      ],
      "Resource": [
        "arn:aws:cloudformation:us-east-2:373633008995:stack/VentusDemoConnectorsStack/*",
        "arn:aws:cloudformation:us-east-2:373633008995:stack/VentusIdentityStack/*",
        "arn:aws:cloudformation:us-east-2:373633008995:stack/VentusEvidenceStoreStack/*",
        "arn:aws:cloudformation:us-east-2:373633008995:stack/VentusConsoleApiStack/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:CalledViaAWSMCP": "aws-mcp.amazonaws.com"
        }
      }
    },
    {
      "Sid": "InspectDemoRuntimeViaAwsMcp",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET",
        "cloudformation:ListStacks",
        "cloudwatch:DescribeAlarms",
        "cloudwatch:GetMetricData",
        "cloudwatch:GetMetricStatistics",
        "cloudwatch:ListMetrics",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:GetPolicy",
        "logs:DescribeLogGroups",
        "logs:DescribeLogStreams",
        "logs:FilterLogEvents",
        "logs:GetLogEvents",
        "logs:GetQueryResults",
        "logs:StartQuery"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:CalledViaAWSMCP": "aws-mcp.amazonaws.com"
        }
      }
    },
    {
      "Sid": "InspectDemoSecretMetadataWithoutValuesViaAwsMcp",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:DescribeSecret",
        "secretsmanager:ListSecretVersionIds"
      ],
      "Resource": "arn:aws:secretsmanager:us-east-2:373633008995:secret:ventus/staging/demo-connectors-*",
      "Condition": {
        "StringEquals": {
          "aws:CalledViaAWSMCP": "aws-mcp.amazonaws.com"
        }
      }
    },
    {
      "Sid": "InspectAndRedeployVentusAmplifyViaAwsMcp",
      "Effect": "Allow",
      "Action": [
        "amplify:GetApp",
        "amplify:GetBranch",
        "amplify:GetJob",
        "amplify:ListBranches",
        "amplify:ListJobs",
        "amplify:StartJob",
        "amplify:UpdateBranch"
      ],
      "Resource": [
        "arn:aws:amplify:us-east-1:373633008995:apps/d1gaewa028qzng",
        "arn:aws:amplify:us-east-1:373633008995:apps/d1gaewa028qzng/branches/dev",
        "arn:aws:amplify:us-east-1:373633008995:apps/d1gaewa028qzng/branches/dev/jobs/*",
        "arn:aws:amplify:us-east-1:373633008995:apps/d1gaewa028qzng/branches/staging",
        "arn:aws:amplify:us-east-1:373633008995:apps/d1gaewa028qzng/branches/staging/jobs/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:CalledViaAWSMCP": "aws-mcp.amazonaws.com"
        }
      }
    },
    {
      "Sid": "InspectVentusIdentityAndDatabaseViaAwsMcp",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:DescribeUserPool",
        "cognito-idp:DescribeUserPoolClient",
        "cognito-idp:ListGroups",
        "cognito-idp:ListUserPoolClients",
        "cognito-idp:ListUserPools",
        "rds:DescribeDBClusters",
        "rds:DescribeDBInstances"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:CalledViaAWSMCP": "aws-mcp.amazonaws.com"
        }
      }
    },
    {
      "Sid": "OperateEvidenceStoreMigratorViaAwsMcp",
      "Effect": "Allow",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": "arn:aws:lambda:us-east-2:373633008995:function:ventus-evidence-store-migrator",
      "Condition": {
        "StringEquals": {
          "aws:CalledViaAWSMCP": "aws-mcp.amazonaws.com"
        }
      }
    },
    {
      "Sid": "InspectVentusCostViaAwsMcp",
      "Effect": "Allow",
      "Action": [
        "billing:GetBillingViewData",
        "budgets:ViewBudget",
        "ce:GetAnomalies",
        "ce:GetAnomalyMonitors",
        "ce:GetAnomalySubscriptions",
        "ce:GetCostAndUsage",
        "ce:GetCostForecast",
        "ce:GetDimensionValues",
        "ce:GetReservationUtilization",
        "ce:GetSavingsPlansUtilization"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:CalledViaAWSMCP": "aws-mcp.amazonaws.com"
        }
      }
    },
    {
      "Sid": "NeverExposeSecretValuesViaAwsMcp",
      "Effect": "Deny",
      "Action": [
        "secretsmanager:BatchGetSecretValue",
        "secretsmanager:GetSecretValue"
      ],
      "Resource": "*",
      "Condition": {
        "Bool": {
          "aws:ViaAWSMCPService": "true"
        }
      }
    },
    {
      "Sid": "BlockDestructiveAdministrationViaAwsMcp",
      "Effect": "Deny",
      "Action": [
        "account:*",
        "amplify:Delete*",
        "apigateway:DELETE",
        "cloudformation:Delete*",
        "iam:*",
        "lambda:Delete*",
        "organizations:*",
        "route53:ChangeResourceRecordSets",
        "secretsmanager:Delete*"
      ],
      "Resource": "*",
      "Condition": {
        "Bool": {
          "aws:ViaAWSMCPService": "true"
        }
      }
    }
  ]
}
