{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowAccountAdmin",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::373633008995:root"
      },
      "Action": "kms:*",
      "Resource": "*"
    },
    {
      "Sid": "AllowSecretsManagerUse",
      "Effect": "Allow",
      "Principal": {
        "Service": "secretsmanager.amazonaws.com"
      },
      "Action": [
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:Encrypt",
        "kms:GenerateDataKey",
        "kms:ReEncryptFrom",
        "kms:ReEncryptTo"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "secretsmanager.us-east-2.amazonaws.com",
          "kms:CallerAccount": "373633008995"
        }
      }
    },
    {
      "Sid": "AllowRuntimeDecryptForDbSecret",
      "Effect": "Allow",
      "Principal": {
        "AWS": [
          "arn:aws:iam::373633008995:role/service-role/ventus-api-role-k35w93j6",
          "arn:aws:iam::373633008995:role/service-role/ventus-ingest-transactions-role-49aab53k",
          "arn:aws:iam::373633008995:role/service-role/ventus-classify-transactions-role-k1rwfzq0",
          "arn:aws:iam::373633008995:role/service-role/ventus-analyze-pillar-transactions-role-habi5o3q",
          "arn:aws:iam::373633008995:role/service-role/ventus-analyze-lifestyle-signals-role-91yxbbj6",
          "arn:aws:iam::373633008995:role/service-role/ventus-risk-detection-role-hajg9u8p",
          "arn:aws:iam::373633008995:role/service-role/ventus-travel-detection-role-qq2lcygd",
          "arn:aws:iam::373633008995:role/VentusExistingInfraStack-VentusStuckJobMonitorServi-4j9338GOsPoI"
        ]
      },
      "Action": [
        "kms:Decrypt",
        "kms:DescribeKey"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "secretsmanager.us-east-2.amazonaws.com",
          "kms:CallerAccount": "373633008995"
        }
      }
    },
    {
      "Sid": "AllowRuntimeDecryptForModelProviderSecret",
      "Effect": "Allow",
      "Principal": {
        "AWS": [
          "arn:aws:iam::373633008995:role/service-role/ventus-classify-transactions-role-k1rwfzq0",
          "arn:aws:iam::373633008995:role/service-role/ventus-analyze-pillar-transactions-role-habi5o3q",
          "arn:aws:iam::373633008995:role/service-role/ventus-analyze-lifestyle-signals-role-91yxbbj6",
          "arn:aws:iam::373633008995:role/service-role/ventus-risk-detection-role-hajg9u8p",
          "arn:aws:iam::373633008995:role/service-role/ventus-travel-detection-role-qq2lcygd"
        ]
      },
      "Action": [
        "kms:Decrypt",
        "kms:DescribeKey"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "secretsmanager.us-east-2.amazonaws.com",
          "kms:CallerAccount": "373633008995"
        }
      }
    }
  ]
}
